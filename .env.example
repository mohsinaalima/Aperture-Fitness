# FastAPI settings (copy to apps/api/.env or provide in the API host)
APP_NAME=Aperture Fitness API
ENVIRONMENT=production
FRONTEND_URL=https://your-frontend-domain.example
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/aperture_fitness
AUTH_SESSION_COOKIE=aperture_session
AUTH_SESSION_EXPIRE_DAYS=7

# Optional Google OAuth settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
